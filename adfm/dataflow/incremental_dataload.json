{
	"name": "incremental_dataload",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_people",
						"type": "DatasetReference"
					},
					"name": "bronzesource"
				},
				{
					"dataset": {
						"referenceName": "targetsqldb",
						"type": "DatasetReference"
					},
					"name": "sinkassource"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "targetsqldb",
						"type": "DatasetReference"
					},
					"name": "sink"
				}
			],
			"transformations": [
				{
					"name": "doesnotexist"
				},
				{
					"name": "AlterRow1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          {id } as integer,",
				"          fname as string,",
				"          lname as string,",
				"          {age } as string,",
				"          hobby as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     mode: 'read') ~> bronzesource",
				"source(output(",
				"          id as integer,",
				"          fname as string,",
				"          lname as string,",
				"          age as integer,",
				"          hobby as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     waterMarkColumn: 'id',",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table',",
				"     mode: 'read') ~> sinkassource",
				"bronzesource, sinkassource exists({id } == id,",
				"     negate:true,",
				"     broadcast: 'auto')~> doesnotexist",
				"doesnotexist alterRow() ~> AlterRow1",
				"AlterRow1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          id as integer,",
				"          fname as string,",
				"          lname as string,",
				"          age as integer,",
				"          hobby as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:true,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          id = {id },",
				"          fname,",
				"          lname,",
				"          age = {age },",
				"          hobby",
				"     ),",
				"     preCommands: [],",
				"     postCommands: []) ~> sink"
			]
		}
	}
}