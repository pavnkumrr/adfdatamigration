{
	"name": "mergingrows",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "personainfo_dataset",
						"type": "DatasetReference"
					},
					"name": "source"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_dftarget",
						"type": "DatasetReference"
					},
					"name": "sink"
				}
			],
			"transformations": [],
			"scriptLines": [
				"source(output(",
				"          {id } as string,",
				"          fname as string,",
				"          lname as string,",
				"          {age } as string,",
				"          hobby as string",
				"     ),",
				"     allowSchemaDrift: false,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source",
				"source sink(allowSchemaDrift: false,",
				"     validateSchema: false,",
				"     input(",
				"          {id } as string,",
				"          fname as string,",
				"          lname as string,",
				"          {age } as string,",
				"          hobby as string",
				"     ),",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink"
			]
		}
	}
}