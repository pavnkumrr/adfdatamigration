{
	"name": "df_filter",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"name": "dfsource"
				}
			],
			"sinks": [
				{
					"name": "dftargetsink",
					"rejectedDataLinkedService": {
						"referenceName": "ls_datalake",
						"type": "LinkedServiceReference"
					}
				},
				{
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "filterbyfueltype"
				},
				{
					"name": "splitenginesize"
				}
			],
			"scriptLines": [
				"source(output(",
				"          Brand as string,",
				"          Model as string,",
				"          Year as string,",
				"          Engine_Size as string,",
				"          Fuel_Type as string,",
				"          Transmission as string,",
				"          Mileage as string,",
				"          Doors as string,",
				"          Owner_Count as string,",
				"          Price as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false) ~> dfsource",
				"dfsource filter(equalsIgnoreCase(Fuel_Type, 'Petrol')) ~> filterbyfueltype",
				"filterbyfueltype split(Engine_Size>='2',",
				"     disjoint: false) ~> splitenginesize@(high, low)",
				"splitenginesize@high sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['petrol_highEngine.csv'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     mapColumn(",
				"          Brand,",
				"          Model,",
				"          Year,",
				"          Engine_Size,",
				"          Fuel_Type,",
				"          Transmission,",
				"          Mileage,",
				"          Doors,",
				"          Owner_Count,",
				"          Price",
				"     ),",
				"     partitionBy('hash', 1),",
				"     preCommands: [],",
				"     postCommands: []) ~> dftargetsink",
				"splitenginesize@low sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['petrol_lowengine.csv'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1),",
				"     preCommands: [],",
				"     postCommands: []) ~> sink1"
			]
		}
	}
}