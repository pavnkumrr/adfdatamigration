{
	"name": "df_filter",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_dfsourcefile",
						"type": "DatasetReference"
					},
					"name": "dfsource"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_dftarget",
						"type": "DatasetReference"
					},
					"name": "dftargetsink",
					"rejectedDataLinkedService": {
						"referenceName": "ls_datalake",
						"type": "LinkedServiceReference"
					}
				}
			],
			"transformations": [
				{
					"name": "filterbyfueltype"
				}
			],
			"scriptLines": [
				"source(output(",
				"          Brand as string,",
				"          Model as string,",
				"          Year as string,",
				"          Engine_Size as string,",
				"          Fuel_Type as string,",
				"          Transmission as string,",
				"          Mileage as string,",
				"          Doors as string,",
				"          Owner_Count as string,",
				"          Price as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> dfsource",
				"dfsource filter(equalsIgnoreCase(Fuel_Type, 'Petrol')\r",
				") ~> filterbyfueltype",
				"filterbyfueltype sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['cars_petrol.csv'],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> dftargetsink"
			]
		}
	}
}