{
	"name": "incrementaldataload",
	"properties": {
		"description": "implementing incremental data load",
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "personainfo_dataset",
						"type": "DatasetReference"
					},
					"name": "source"
				},
				{
					"dataset": {
						"referenceName": "ds_dftarget",
						"type": "DatasetReference"
					},
					"name": "sinkassource"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_dftarget",
						"type": "DatasetReference"
					},
					"name": "sink"
				}
			],
			"transformations": [
				{
					"name": "doesnotexist"
				}
			],
			"scriptLines": [
				"source(output(",
				"          {id } as integer,",
				"          fname as string,",
				"          lname as string,",
				"          {age } as string,",
				"          hobby as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source",
				"source(output(",
				"          {id } as string,",
				"          fname as string,",
				"          lname as string,",
				"          {age } as string,",
				"          hobby as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> sinkassource",
				"source exists(ERROR_FUNCTION('') == ERROR_FUNCTION(''),",
				"     negate:false,",
				"     broadcast: 'auto')~> doesnotexist",
				"doesnotexist sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          {id } as string,",
				"          fname as string,",
				"          lname as string,",
				"          {age } as string,",
				"          hobby as string",
				"     ),",
				"     partitionFileNames:['people.csv'],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink"
			]
		}
	}
}