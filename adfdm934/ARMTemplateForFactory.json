		},
		{
			"name": "[concat(parameters('factoryName'), '/df_filter')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "ds_dfsourcefile",
								"type": "DatasetReference"
							},
							"name": "dfsource"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "ds_dftarget",
								"type": "DatasetReference"
							},
							"name": "dftargetsink",
							"rejectedDataLinkedService": {
								"referenceName": "ls_datalake",
								"type": "LinkedServiceReference"
							}
						},
						{
							"dataset": {
								"referenceName": "ds_dftarget",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [
						{
							"name": "filterbyfueltype"
						},
						{
							"name": "splitenginesize"
						}
					],
					"scriptLines": [
						"source(output(",
						"          Brand as string,",
						"          Model as string,",
						"          Year as string,",
						"          Engine_Size as string,",
						"          Fuel_Type as string,",
						"          Transmission as string,",
						"          Mileage as string,",
						"          Doors as string,",
						"          Owner_Count as string,",
						"          Price as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> dfsource",
						"dfsource filter(equalsIgnoreCase(Fuel_Type, 'Petrol')) ~> filterbyfueltype",
						"filterbyfueltype split(Engine_Size>='2',",
						"     disjoint: false) ~> splitenginesize@(high, low)",
						"splitenginesize@high sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          {id } as string,",
						"          fname as string,",
						"          lname as string,",
						"          {age } as string,",
						"          hobby as string",
						"     ),",
						"     partitionFileNames:['petrol_highEngine.csv'],",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     mapColumn(",
						"          Brand,",
						"          Model,",
						"          Year,",
						"          Engine_Size,",
						"          Fuel_Type,",
						"          Transmission,",
						"          Mileage,",
						"          Doors,",
						"          Owner_Count,",
						"          Price",
						"     ),",
						"     partitionBy('hash', 1)) ~> dftargetsink",
						"splitenginesize@low sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          {id } as string,",
						"          fname as string,",
						"          lname as string,",
						"          {age } as string,",
						"          hobby as string",
						"     ),",
						"     partitionFileNames:['petrol_lowengine.csv'],",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     partitionBy('hash', 1)) ~> sink1"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/ds_dfsourcefile')]",
				"[concat(variables('factoryId'), '/datasets/ds_dftarget')]",
				"[concat(variables('factoryId'), '/linkedServices/ls_datalake')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/incrementaldataload')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "implementing incremental data load",
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "personainfo_dataset",
								"type": "DatasetReference"
							},
							"name": "source"
						},
						{
							"dataset": {
								"referenceName": "ds_dftarget",
								"type": "DatasetReference"
							},
							"name": "sinkassource"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "ds_dftarget",
								"type": "DatasetReference"
							},
							"name": "sink"
						}
					],
					"transformations": [
						{
							"name": "DoesnotExistInSINK"
						}
					],
					"scriptLines": [
						"source(output(",
						"          {id } as integer,",
						"          fname as string,",
						"          lname as string,",
						"          {age } as string,",
						"          hobby as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> source",
						"source(output(",
						"          {id } as integer,",
						"          fname as string,",
						"          lname as string,",
						"          {age } as string,",
						"          hobby as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> sinkassource",
						"source, sinkassource exists(source@{id } == sinkassource@{id },",
