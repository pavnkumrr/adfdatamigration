{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adfdm934"
		},
		"ls_onPremServer_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_onPremServer'"
		},
		"ls_datalake_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_datalake'"
		},
		"ls_onPremServer_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "D"
		},
		"ls_onPremServer_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "AdventureWorksLT2017"
		},
		"ls_onPremServer_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sa"
		},
		"ls_datalake_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://targetdatasource.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adfdm934_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_datalake_accountKey": {
						"value": "[parameters('ls_datalake_accountKey')]"
					},
					"ls_onPremServer_password": {
						"value": "[parameters('ls_onPremServer_password')]"
					},
					"ls_datalake_properties_typeProperties_url": {
						"value": "[parameters('ls_datalake_properties_typeProperties_url')]"
					},
					"ls_onPremServer_properties_typeProperties_server": {
						"value": "[parameters('ls_onPremServer_properties_typeProperties_server')]"
					},
					"ls_onPremServer_properties_typeProperties_database": {
						"value": "[parameters('ls_onPremServer_properties_typeProperties_database')]"
					},
					"ls_onPremServer_properties_typeProperties_userName": {
						"value": "[parameters('ls_onPremServer_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}