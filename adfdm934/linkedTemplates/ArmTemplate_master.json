{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adfdm934"
		},
		"SqlServer1_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'SqlServer1'"
		},
		"datalakels1_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'datalakels1'"
		},
		"lsadvnwrk_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'lsadvnwrk'"
		},
		"SqlServer1_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "D"
		},
		"SqlServer1_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "salesDB"
		},
		"SqlServer1_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sa"
		},
		"datalakels1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://targetdatasource.dfs.core.windows.net/"
		},
		"lsadvnwrk_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "D"
		},
		"lsadvnwrk_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "AdventureWorksLT2017"
		},
		"lsadvnwrk_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sa"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adfdm934_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"SqlServer1_password": {
						"value": "[parameters('SqlServer1_password')]"
					},
					"datalakels1_accountKey": {
						"value": "[parameters('datalakels1_accountKey')]"
					},
					"lsadvnwrk_password": {
						"value": "[parameters('lsadvnwrk_password')]"
					},
					"SqlServer1_properties_typeProperties_server": {
						"value": "[parameters('SqlServer1_properties_typeProperties_server')]"
					},
					"SqlServer1_properties_typeProperties_database": {
						"value": "[parameters('SqlServer1_properties_typeProperties_database')]"
					},
					"SqlServer1_properties_typeProperties_userName": {
						"value": "[parameters('SqlServer1_properties_typeProperties_userName')]"
					},
					"datalakels1_properties_typeProperties_url": {
						"value": "[parameters('datalakels1_properties_typeProperties_url')]"
					},
					"lsadvnwrk_properties_typeProperties_server": {
						"value": "[parameters('lsadvnwrk_properties_typeProperties_server')]"
					},
					"lsadvnwrk_properties_typeProperties_database": {
						"value": "[parameters('lsadvnwrk_properties_typeProperties_database')]"
					},
					"lsadvnwrk_properties_typeProperties_userName": {
						"value": "[parameters('lsadvnwrk_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}